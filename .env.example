# =============================================================================
# Weather API — Environment Variables
# https://weather.maybesurya.dev
#
# Copy this file to .env.local and fill in your credentials.
# NEVER commit real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Upstash Redis — Distributed Rate Limiting (required for production)
# Create a free database at https://upstash.com
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# -----------------------------------------------------------------------------
# Primary Weather Provider — WeatherAPI (Optional, Requires Commercial License for Public Proxying)
# Register at https://www.weatherapi.com/
#
# TERMS / LICENSING NOTICE:
# Review official terms at https://www.weatherapi.com/terms.aspx and
# pricing at https://www.weatherapi.com/pricing.aspx.
# WeatherAPI's free plan restricts redistributing data through public third-party
# proxy APIs. A commercial subscription is required for public API proxying.
# Keep this variable empty to use the zero-key open provider chain (Open-Meteo).
# -----------------------------------------------------------------------------
WEATHER_API_KEY=

# -----------------------------------------------------------------------------
# Secondary Weather Provider — Meteosource (Optional, Disabled by Default)
# Register at https://www.meteosource.com/
#
# TERMS / LICENSING NOTICE:
# Meteosource Terms of Service explicitly restrict transferring or providing
# API access outside customer internal applications. Meteosource is EXCLUDED
# from the default production fallback chain. Only configure this key and add
# "meteosource" to WEATHER_PROVIDER_FALLBACKS if you hold a commercial license
# explicitly permitting public proxy usage.
# -----------------------------------------------------------------------------
METEOSOURCE_API_KEY=

# -----------------------------------------------------------------------------
# Provider Chain Configuration
# Providers are tried in order until one succeeds.
# Supported names: weatherapi, meteosource, open-meteo, met-no
#
# SAFE DEFAULT POLICY:
# - Default primary: "open-meteo" (zero-key open access, CC BY 4.0)
#   (Automatically uses "weatherapi" if WEATHER_API_KEY is configured)
# - Default fallbacks: "met-no" (MET Norway Locationforecast 2.0 open data)
#   (Automatically uses "open-meteo,met-no" if primary is "weatherapi")
# - Meteosource is NOT enabled by default due to public proxying terms restrictions.
# -----------------------------------------------------------------------------
WEATHER_PROVIDER_PRIMARY=open-meteo
WEATHER_PROVIDER_FALLBACKS=met-no

# Set to "false" to disable Open-Meteo if your deployment exceeds non-commercial
# free-tier usage (10,000 calls/day) and an Open-Meteo commercial plan is not active.
# Open-Meteo terms: https://open-meteo.com/en/terms
WEATHER_ENABLE_OPEN_METEO_FALLBACK=true

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
WEATHER_RATE_LIMIT=30
WEATHER_RATE_LIMIT_WINDOW=60

# "closed" = reject requests if Redis is unavailable (safer for public APIs)
# "open"   = allow requests through if Redis is unavailable (higher availability)
RATE_LIMIT_FAIL_MODE=closed

# -----------------------------------------------------------------------------
# Provider Timeouts (milliseconds)
# -----------------------------------------------------------------------------
WEATHERAPI_TIMEOUT_MS=3000
METEOSOURCE_TIMEOUT_MS=3500
OPEN_METEO_TIMEOUT_MS=3000
MET_NO_TIMEOUT_MS=3500

# -----------------------------------------------------------------------------
# Provider User-Agent (Required by MET Norway; good practice for all providers)
# MET Norway Terms of Service require identifying contact email or website URL.
# -----------------------------------------------------------------------------
WEATHER_PROVIDER_USER_AGENT=maybesurya-weather-api/1.0 (+https://weather.maybesurya.dev)

# -----------------------------------------------------------------------------
# Geolocation Fallback
# Used when Cloudflare visitor-location headers are absent (e.g. local dev)
# -----------------------------------------------------------------------------
WEATHER_DEFAULT_CITY=Dehradun
